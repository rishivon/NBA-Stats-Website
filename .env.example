# Copy this file to .env for local development.
# Do not put production or Supabase credentials in this example file.

# Local Docker Postgres. The docker-compose.local.yml setup uses localhost-only
# ports and trust auth, so no password is needed for local development.
DATABASE_URL='jdbc:postgresql://localhost:5432/nba_visualizer'
DATABASE_USERNAME='nba_visualizer'
DATABASE_PASSWORD=''
JPA_DDL_AUTO='validate'

# Local Docker Redis.
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_PASSWORD=''
REDIS_URL='redis://localhost:6379'

# Local service URLs.
NBA_PROXY_BASE_URL='http://localhost:8000'
DB_PATH='./nba_stats.db'
